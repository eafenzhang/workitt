{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["vite/client","react"],
    "skipLibCheck": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "strict": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": false,
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@minopencil/pen-types": ["./src/engine/packages/pen-types/src"],
      "@minopencil/pen-types/*": ["./src/engine/packages/pen-types/src/*"],
      "@minopencil/pen-core": ["./src/engine/packages/pen-core/src"],
      "@minopencil/pen-core/*": ["./src/engine/packages/pen-core/src/*"],
      "@minopencil/pen-engine": ["./src/engine/packages/pen-engine/src"],
      "@minopencil/pen-engine/*": ["./src/engine/packages/pen-engine/src/*"],
      "@minopencil/pen-react": ["./src/engine/packages/pen-react/src"],
      "@minopencil/pen-react/*": ["./src/engine/packages/pen-react/src/*"],
      "@minopencil/pen-renderer": ["./src/engine/packages/pen-renderer/src"],
      "@minopencil/pen-renderer/*": ["./src/engine/packages/pen-renderer/src/*"],
      "@minopencil/pen-ai-skills": ["./src/engine/packages/pen-ai-skills/src"],
      "@minopencil/pen-ai-skills/*": ["./src/engine/packages/pen-ai-skills/src/*"]
    }
  },
  "include": ["src","auto-imports.d.ts"]
}
